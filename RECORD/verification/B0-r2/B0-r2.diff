diff --git a/src/scss/03-components/pages/page-items/_products-assets.scss b/src/scss/03-components/pages/page-items/_products-assets.scss
index 330d142..8a03943 100644
--- a/src/scss/03-components/pages/page-items/_products-assets.scss
+++ b/src/scss/03-components/pages/page-items/_products-assets.scss
@@ -1,37 +1,23 @@
-// Products catalog assets — the Figma frame's typefaces, self-hosted like the
-// theme fonts (woff2, OFL; licences in static/fonts/licenses/), and the
+// Products catalog assets — the Figma frame's typeface (v2: Inter), self-hosted
+// like the theme fonts (woff2, OFL; licence in static/fonts/licenses/), and the
 // frame's chevron icon for the filter selects. Configured by app.scss via
 // `with ($STATIC_DIR: $STATIC_DIR)` because url() is not rewritten by webpack.
 $STATIC_DIR: './static/' !default;
 
-@font-face {
-  font-family: 'DM Serif Text';
-  font-style: normal;
-  font-weight: 400;
-  font-display: swap;
-  src: url('#{$STATIC_DIR}fonts/dm-serif-text-400.woff2') format('woff2');
-}
-
-@each $w in 400, 500, 600 {
-  @font-face {
-    font-family: 'Geist';
-    font-style: normal;
-    font-weight: $w;
-    font-display: swap;
-    src: url('#{$STATIC_DIR}fonts/geist-#{$w}.woff2') format('woff2');
-  }
+@each $w in 400, 500, 600, 700 {
   @font-face {
-    font-family: 'Geist Mono';
+    font-family: 'Inter';
     font-style: normal;
     font-weight: $w;
     font-display: swap;
-    src: url('#{$STATIC_DIR}fonts/geist-mono-#{$w}.woff2') format('woff2');
+    src: url('#{$STATIC_DIR}fonts/inter-#{$w}.woff2') format('woff2');
   }
 }
 
 main#app .page-item--products {
-  --catalog-font-serif: 'DM Serif Text', Georgia, serif;
-  --catalog-font-sans: 'Geist', 'Helvetica Neue', Arial, sans-serif;
-  --catalog-font-mono: 'Geist Mono', Menlo, monospace;
+  --catalog-font: 'Inter', 'Helvetica Neue', Arial, sans-serif;
+  --catalog-font-serif: var(--catalog-font);
+  --catalog-font-sans: var(--catalog-font);
+  --catalog-font-mono: var(--catalog-font);
   --catalog-chevron: url('#{$STATIC_DIR}imgs/icon-chevron-down.svg');
 }
diff --git a/src/scss/03-components/pages/page-items/_products.scss b/src/scss/03-components/pages/page-items/_products.scss
index 243d484..16c707f 100644
--- a/src/scss/03-components/pages/page-items/_products.scss
+++ b/src/scss/03-components/pages/page-items/_products.scss
@@ -1,14 +1,15 @@
 // Products catalog — converted from the Figma frame `rare-metal-catalog`
-// (RECORD/inputs/A1-figma-catalog.*). Per the A1-2 ruling the styles ARE the
-// design's: its colours, type, spacing and dark surface are used as drawn, in
-// both app colour schemes. The design values are held as custom properties
-// on the section root; the typefaces come from _products-assets.scss.
+// (RECORD/inputs/A1-figma-catalog.*, updated at B0-2 from
+// RECORD/inputs/B0-figma-catalog-v2.*). Per the A1-2 ruling the styles ARE
+// the design's: its colours, type, spacing and dark surface are used as
+// drawn, in both app colour schemes. The design values are held as custom
+// properties on the section root; the typeface comes from _products-assets.scss.
 .page-view .page-item--catalog {
   // the page-item wrapper carries the frame's own surface and padding
   --pi-padding: 100px 80px;
   --pi-radius: 0;
   --pi-shadow: none;
-  background: #08080a;
+  background: #091725;
   color: #f3f4f6;
 
   @media (max-width: 900px) {
@@ -20,6 +21,7 @@
 }
 
 .page-item--products {
+  --c-section: #091725;
   --c-bg: #08080a;
   --c-card: #111115;
   --c-border: #222228;
@@ -230,7 +232,7 @@
     margin: 0;
     font-family: var(--catalog-font-serif);
     font-size: 20px;
-    font-weight: 400;
+    font-weight: 700;
     line-height: normal;
     color: var(--c-text);
   }
@@ -420,7 +422,7 @@ main#app .page-item--products {
   .product-name {
     font-family: var(--catalog-font-serif);
     font-size: 20px;
-    font-weight: 400;
+    font-weight: 700;
     line-height: normal;
     color: var(--c-text);
     margin: 0;
